# Postgres connection (local: postgres://USER@127.0.0.1:5432/zoytoy · Vercel: added by the Neon integration)
DATABASE_URL=
# Long random string used to sign admin sessions and game tokens (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=
# Local development admin created by `pnpm seed` (leave the password empty on hosted databases)
SEED_ADMIN_EMAIL=admin@zoytoy.test
SEED_ADMIN_PASSWORD=

# --- Vercel only ---
# Photo storage; added when the Vercel Blob store is connected with "Add a read-write token env var"
# (OIDC-only connections set just BLOB_STORE_ID, which the Payload adapter cannot use). Unset = apps/web/media
BLOB_READ_WRITE_TOKEN=
# Optional: only Vercel Cron may call /api/cron/daily (expired reservations + Telegram morning digest)
CRON_SECRET=

# --- Optional ---
# Telegram bot for orders (docs/09 §5); the bot is off when unset. The webhook is registered on production builds.
TELEGRAM_BOT_TOKEN=
# Fallback chat when Admin → Site settings → Telegram → Chat ID is empty
TELEGRAM_CHAT_ID=
