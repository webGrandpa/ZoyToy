{
  "name": "zoytoy",
  "private": true,
  "description": "Zoy Toy \u2014 toy shop with rentals and mini-games (Batumi)",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=@zoytoy/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "seed": "pnpm --filter @zoytoy/web seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=22.23"
  }
}
